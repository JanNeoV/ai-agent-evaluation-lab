{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-lab:1:invocation",
  "type": "object",
  "properties": {
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "timeout",
        "error",
        "ambiguous"
      ]
    },
    "response_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "invocation_id",
    "candidate_id",
    "question_id",
    "repetition",
    "status",
    "response_text",
    "latency_ms",
    "request_id",
    "raw_sha256",
    "started_at",
    "completed_at",
    "error_code"
  ],
  "additionalProperties": false
}

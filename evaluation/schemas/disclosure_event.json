{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-lab:1:disclosure_event",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "reveal_stage": {
      "type": "string",
      "minLength": 1
    },
    "authorization_basis": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "actor",
    "role",
    "artifact_sha256",
    "purpose",
    "at",
    "reveal_stage",
    "authorization_basis"
  ],
  "additionalProperties": false
}

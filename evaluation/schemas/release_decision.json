{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-lab:1:release_decision",
  "type": "object",
  "properties": {
    "candidate_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "metrics_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gates": {
      "type": "object"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "inconclusive"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "candidate_id",
    "predecessor",
    "policy_sha256",
    "metrics_sha256",
    "gates",
    "decision",
    "reason",
    "recorded_at"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-lab:1:answer",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "abstain",
        "clarification_needed"
      ]
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "explanation_de": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "columns",
    "rows",
    "units",
    "caveats",
    "evidence_ids",
    "explanation_de"
  ],
  "additionalProperties": false
}
